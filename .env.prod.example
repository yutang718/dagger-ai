# --- Dagger-AI PRODUCTION configuration -------------------------------------
# Copy to .env on the server, then: docker compose -f docker-compose.prod.yml up -d --build

# Domain that points at this server (Caddy gets a Let's Encrypt cert for it).
DAGGER_DOMAIN=dagger.example.com

# Console login — MUST be changed from defaults for a public deployment.
DAGGER_ADMIN_USER=your-admin-name
DAGGER_ADMIN_PASSWORD=use-a-long-unique-password
# Generate: openssl rand -hex 32
DAGGER_SECRET_KEY=paste-a-64-char-random-hex-string-here
DAGGER_TOKEN_HOURS=8

# Keep the authorization gate ON in production.
DAGGER_REQUIRE_AUTHORIZATION=true

# Optional attacker/judge LLM (offline needs no key).
DAGGER_ATTACKER_PROVIDER=offline
DAGGER_ATTACKER_BASE_URL=
DAGGER_ATTACKER_API_KEY=
DAGGER_ATTACKER_MODEL=
