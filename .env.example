# --- Dagger-AI configuration -------------------------------------------------
# Copy to .env and edit before first start.  ./dagger start does this for you.

# Console login
DAGGER_ADMIN_USER=admin
DAGGER_ADMIN_PASSWORD=Admin@12345
DAGGER_SECRET_KEY=change-me-to-a-long-random-string
DAGGER_TOKEN_HOURS=12

# Safety: require an explicit authorization note on every target before a run.
# Keep this true unless you have a very good reason.
DAGGER_REQUIRE_AUTHORIZATION=true

# Attacker/judge LLM.  provider = offline | openai | anthropic
#   offline  -> no API key needed; deterministic payloads + heuristic judging
#   openai   -> any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, LM Studio)
#   anthropic-> Anthropic Messages API
DAGGER_ATTACKER_PROVIDER=offline
DAGGER_ATTACKER_BASE_URL=
DAGGER_ATTACKER_API_KEY=
DAGGER_ATTACKER_MODEL=

# Example for a local Ollama model:
#   DAGGER_ATTACKER_PROVIDER=openai
#   DAGGER_ATTACKER_BASE_URL=http://host.docker.internal:11434/v1
#   DAGGER_ATTACKER_MODEL=llama3.1
